# Robinhood Chain RPC for the facilitator
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Comma-separated additional fallback RPC endpoints (public defaults already included)
ROBINHOOD_RPC_FALLBACK_URLS=
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional: live $VERGE contract address. Leave blank until the token contract is deployed.
NEXT_PUBLIC_VERGE_TOKEN_CA=

# Optional: dedicated Alchemy RPC key, used as the PRIMARY provider for Robinhood,
# Ethereum, Base, Arbitrum, Polygon, and Solana rails (public RPCs remain the fallback
# chain if unset or if Alchemy has an outage). Sui always uses its public GraphQL RPC —
# Alchemy has no Sui coverage.
ALCHEMY_API_KEY=

# Demo merchant wallet (receives USDG payments)
DEMO_MERCHANT_WALLET=

# Postgres connection string (Supabase pooler recommended). Required.
DATABASE_URL=

# Encryption key for the credential vault (AES-256-GCM), 32+ random bytes as hex.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is derived from DATABASE_URL — fine for local dev, NOT for production.
VERGE_VAULT_KEY=
