# Robinhood Chain RPC for the facilitator
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Comma-separated additional fallback RPC endpoints (public defaults already included)
ROBINHOOD_RPC_FALLBACK_URLS=
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Demo merchant wallet (receives USDG payments)
DEMO_MERCHANT_WALLET=

# Postgres connection string (Supabase pooler recommended). Required.
DATABASE_URL=
