# ─────────────────────────────────────────────────────────────────────────────
#  Verge x402 Gateway — environment variable reference
#  Copy this file to .env.local and fill in the values.
#
#  cp .env.example .env.local    # or run: ./scripts/setup.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string. When running via docker-compose, this is
# automatically overridden to point at the bundled postgres service; you only
# need to set it when connecting to an external Postgres instance.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://verge:verge@localhost:5432/verge

# ── Postgres service (docker-compose only) ────────────────────────────────────
# These control the bundled postgres container. Leave defaults for local dev or
# change them to match your external Postgres credentials.
POSTGRES_USER=verge
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=verge

# ── Robinhood Chain RPC ───────────────────────────────────────────────────────
# Primary RPC endpoint for Robinhood Chain (chain ID 4663). Used by the
# facilitator to verify on-chain payments. Public fallbacks are built-in.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Comma-separated list of additional fallback RPC endpoints. Optional.
# Example: https://robinhood.drpc.org,https://robinhood-rpc.publicnode.com
ROBINHOOD_RPC_FALLBACK_URLS=

# Number of blocks to scan back when searching for settlement transactions.
# Higher values catch slow nodes at the cost of more RPC calls. Default: 10
ROBINHOOD_SCAN_BLOCKS=10

# ── Alchemy (optional but recommended) ────────────────────────────────────────
# Dedicated Alchemy API key used as the PRIMARY provider for Robinhood Chain,
# Ethereum, Base, Arbitrum, Polygon and Solana rails. Public RPCs remain as
# the fallback chain. Leave blank to rely solely on public endpoints.
# Get a key at: https://alchemy.com
ALCHEMY_API_KEY=

# ── Public app URL ─────────────────────────────────────────────────────────────
# The canonical public URL of this deployment (no trailing slash).
# Used in x402 payment challenges and hosted-endpoint URLs.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Reown / WalletConnect ─────────────────────────────────────────────────────
# Reown (WalletConnect) project ID for wallet connection in the /app console.
# Create a project at: https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id_here

# Browser-accessible RPC URL served to the frontend (wallet pop-ups, wagmi).
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ── Vault encryption key ──────────────────────────────────────────────────────
# 32-byte hex key used for AES-256-GCM encryption of the credential vault
# (agent wallet private keys, stored secrets).
# ⚠ REQUIRED in production — if unset a key is derived from DATABASE_URL
#   which is insecure. Rotate with care: existing vault entries cannot be
#   decrypted after a key change.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERGE_VAULT_KEY=replace_with_64_char_hex_string

# ── Settlement wallet ─────────────────────────────────────────────────────────
# EVM address that receives facilitator fees (0.5% of each settled payment).
# Set this to your own wallet to capture fees on your self-hosted instance.
# If left blank, the fee collection step is skipped.
VERGE_SETTLEMENT_WALLET=0xYourWalletAddressHere

# ── Demo merchant wallet ──────────────────────────────────────────────────────
# Wallet used by the interactive live-demo on the landing page.
# Optional — demo is hidden when unset.
DEMO_MERCHANT_WALLET=

# ── $VERGE token contract address ────────────────────────────────────────────
# Optional. Enables fee-tier discounts based on $VERGE token holdings.
# Leave blank if you are not running the token-discount feature.
NEXT_PUBLIC_VERGE_TOKEN_CA=
